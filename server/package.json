{
  "name": "store-product-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepareDevPrisma.mjs && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "check:scripts": "tsc --project tsconfig.scripts.json",
    "prisma:generate": "node scripts/runPrisma.mjs generate",
    "prisma:migrate": "node scripts/runPrisma.mjs migrate deploy",
    "prisma:seed": "tsx ../prisma/seed.ts",
    "db:export-sqlite": "node scripts/runTsx.mjs scripts/exportSqlite.ts",
    "db:migrate-from-sqlite": "node scripts/runTsx.mjs scripts/migrateSqliteToPostgres.ts",
    "db:verify-migration": "node scripts/runTsx.mjs scripts/verifyPostgresMigration.ts",
    "storage:migrate-local-images": "node scripts/runTsx.mjs scripts/migrateLocalImagesToR2.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express-rate-limit": "^7.5.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true
  }
}
