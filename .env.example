# 本地 PostgreSQL 开发或 Render 云端部署均使用此模板；不要提交真实 .env。
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Neon / Render PostgreSQL：生产环境必须使用 postgresql://... 并启用 sslmode=require。
DATABASE_URL="postgresql://store_user:change_me@localhost:5432/store_product?schema=public"

# 单一 Render 服务时，两个值都使用同一个 HTTPS 域名；本地开发可用下面的地址。
FRONTEND_URL="http://localhost:5173"
API_BASE_URL="http://localhost:3001"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# 至少 32 个随机字符。可执行：openssl rand -base64 48
JWT_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"

# 图片/文件上限（MB）
UPLOAD_MAX_MB=5
IMPORT_MAX_MB=10
BACKUP_MAX_MB=50

# Cloudflare R2：生产环境填写 R2_* 或下方 CLOUDINARY_* 中的一组即可。
# R2_PUBLIC_URL 必须是 HTTPS 公网域名。
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_BUCKET="store-product-images"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL="https://images.example.com"

# Cloudinary：免费计划无需绑卡，可替代 R2 保存商品图片。三个值均在 Cloudinary 控制台取得。
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
